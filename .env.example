# ── LLM (opcional) ───────────────────────────────────────────────────────────
# Descomente e preencha para ativar a análise por LLM após a extração.

LLM_ENABLED=false
# LLM_PROVIDER=openai          # openai | anthropic | groq
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini        # modelo do provider escolhido
# LLM_PROMPT=Analise o boleto extraído e indique se há irregularidades:

# ── Servidor ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
